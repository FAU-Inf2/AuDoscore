rm -rf *.class
javac  -Xprefer:source -sourcepath interfaces student/*.java
javac  -Xprefer:source -sourcepath junit:interfaces:student -cp lib/junitpoints.jar:lib/junit.jar:lib/json-simple.jar junit/UnitTest.java
java -cp lib/junitpoints.jar:lib/junit.jar:lib/json-simple.jar:junit:interfaces:student tester.tools.CheckAnnotation UnitTest
java -cp lib/junitpoints.jar:lib/junit.jar:lib/json-simple.jar tester.tools.ForbiddenUseSearcher UnitTest > forbidden.out
if [ -s forbidden.out ]; then \
	cat forbidden.out 1>&2 ; \
	exit 1 ; \
fi
javac  -Xprefer:source -sourcepath interfaces cleanroom/*.java
make run-comparer
java -cp lib/junitpoints.jar:lib/junit.jar:lib/json-simple.jar tester.tools.InterfaceComparator UnitTest
